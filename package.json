{
  "name": "recallgraph",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/scoring.test.mjs tests/validation.test.mjs",
    "test:sql": "node --env-file=.env scripts/test-db.mjs sql",
    "test:api": "node --env-file=.env scripts/test-db.mjs api",
    "test:graph": "node --env-file=.env scripts/test-db.mjs graph",
    "test:all": "node scripts/test-all.mjs",
    "test:record": "node scripts/test-record.mjs",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:snapshot": "node --env-file=.env scripts/dump-schema.mjs",
    "db:queries": "node --env-file=.env scripts/run-queries.mjs",
    "db:seed:bulk": "node --env-file=.env scripts/seed-bulk.mjs",
    "graph:resync": "node --env-file=.env scripts/resync-graph.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "jose": "^6.0.0",
    "neo4j-driver": "^5.28.0",
    "next": "^15.5.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "8.5.31"
  }
}
